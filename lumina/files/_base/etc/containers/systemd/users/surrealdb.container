[Unit]
Description=A SurrealDB container
After=network-online.target

[Container]
Image=docker.io/surrealdb/surrealdb:latest@sha256:3db515b88e79737aa828c05fbf1515748004ba57495ff89a013851cc3f1ad4b9
AutoUpdate=registry
ContainerName=surrealdb
Exec=start file://var/lib/surrealdb/data/database.db
Network=eternal.network
PublishPort=8000:8000
Volume=surrealdb.volume:/var/lib/surrealdb/data:Z

[Service]
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
