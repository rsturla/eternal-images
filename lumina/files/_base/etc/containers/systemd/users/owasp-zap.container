[Unit]
Description=An OWASP ZAP container
After=network-online.target

[Container]
Image=ghcr.io/zaproxy/zaproxy:stable@sha256:9624669db72f54d86c4b46a7064518bd9bf79d8c61a4c31befa9923489f328af
AutoUpdate=registry
ContainerName=owasp-zap
Exec=./zap-webswing.sh
Network=eternal.network
PublishPort=8080:8080
PublishPort=8090:8090

[Service]
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
