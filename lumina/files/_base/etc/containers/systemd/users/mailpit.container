[Unit]
Description=A Mailpit container
After=network-online.target

[Container]
Image=docker.io/axllent/mailpit:latest@sha256:aef2aacc11f075ec0fb6874275ee4a421e688e11a96ebb296134d1735c7761ce
AutoUpdate=registry
ContainerName=mailpit
Network=eternal.network
PublishPort=8025:8025
PublishPort=1025:1025

[Service]
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
