[Unit]
Description=A Mailpit container
After=network-online.target

[Container]
Image=docker.io/axllent/mailpit:latest@sha256:0790692be935ea4420d085694f7985b1f692ca6a8771ab0e0bd8ba75ac180498
AutoUpdate=registry
ContainerName=mailpit
Network=eternal.network
PublishPort=8025:8025
PublishPort=1025:1025

[Service]
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
