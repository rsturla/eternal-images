[Unit]
Description=A Mailpit container
After=network-online.target

[Container]
Image=docker.io/axllent/mailpit:latest@sha256:b68349e3a014b90c5610bfb26b2ae36f3892d7b8cf25ee140c6c71c98d2fcf48
AutoUpdate=registry
ContainerName=mailpit
Network=eternal.network
PublishPort=8025:8025
PublishPort=1025:1025

[Service]
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
