[Unit]
Description=A Keycloak container for identity and access management - http://localhost:8080
After=network-online.target

[Container]
Image=quay.io/keycloak/keycloak:latest@sha256:c68e286cacd87b942ac1939a0a1481461109d6acd3a57dc496969a319a76bbf0
AutoUpdate=registry
ContainerName=keycloak
Exec=start-dev
Environment=KEYCLOAK_ADMIN=admin
Environment=KEYCLOAK_ADMIN_PASSWORD=password
Network=eternal.network
PublishPort=8080:8080

[Service]
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
