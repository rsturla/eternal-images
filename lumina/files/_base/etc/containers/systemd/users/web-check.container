[Unit]
Description=A Web-Check container (https://github.com/Lissy93/web-check) - http://localhost:3000
After=network-online.target

[Container]
Image=ghcr.io/lissy93/web-check:latest@sha256:5e4feb4acbd58573afc2f402e13d6b2fe3e6e1a6bcd0e7605ad7b8c6aabb1bb7
AutoUpdate=registry
ContainerName=web-check
PublishPort=3000:3000
Network=eternal.network

[Service]
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
