[Unit]
Description=A local NPM registry container - http://localhost:4873
After=network-online.target

[Container]
Image=docker.io/verdaccio/verdaccio:latest@sha256:5623458a61100ff2c89526752e8ea2db58ae2d494fa202c18bf4a508ec46892c
AutoUpdate=registry
ContainerName=verdaccio
Network=eternal.network
PublishPort=4873:4873
Volume=verdaccio.volume:/verdaccio/storage:Z

[Service]
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
