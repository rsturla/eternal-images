[Unit]
Description=A local NPM registry container - http://localhost:4873
After=network-online.target

[Container]
Image=docker.io/verdaccio/verdaccio:latest@sha256:560744912b640ddc0f23cd475d296b663b656c0fcfa0ba17cc5ca1cbcb620225
AutoUpdate=registry
ContainerName=verdaccio
Network=eternal.network
PublishPort=4873:4873
Volume=verdaccio.volume:/verdaccio/storage:Z

[Service]
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
