[Unit]
Description=A Postgres container
After=network-online.target

[Container]
Image=docker.io/library/postgres:18@sha256:e3d24f6906d0760bf4da0dae872415391ededefad23fd471c47dc53b0ddf3c42
AutoUpdate=registry
ContainerName=postgres
Environment=POSTGRES_USER=admin
Environment=POSTGRES_PASSWORD=password
Network=eternal.network
PublishPort=5432:5432
Volume=postgres.volume:/var/lib/postgresql/data:Z

[Service]
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
