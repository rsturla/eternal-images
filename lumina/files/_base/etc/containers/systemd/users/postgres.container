[Unit]
Description=A Postgres container
After=network-online.target

[Container]
Image=docker.io/library/postgres:18@sha256:edb0c08dc33befd0262ab3b5cf1c4f3f8cfd8b09e88c05b45adee29d6761ddb6
AutoUpdate=registry
ContainerName=postgres
Environment=POSTGRES_USER=admin
Environment=POSTGRES_PASSWORD=password
Network=eternal.network
PublishPort=5432:5432
Volume=postgres.volume:/var/lib/postgresql/data:Z

[Service]
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
