[Unit]
Description=A Postgres container
After=network-online.target

[Container]
Image=docker.io/library/postgres:18@sha256:4ef4dbc939d61acea57712655ddb4b4ab27419c913f94cca0cd57cb3ea3c2280
AutoUpdate=registry
ContainerName=postgres
Environment=POSTGRES_USER=admin
Environment=POSTGRES_PASSWORD=password
Network=eternal.network
PublishPort=5432:5432
Volume=postgres.volume:/var/lib/postgresql/data:Z

[Service]
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
