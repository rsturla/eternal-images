[Unit]
Description=A Headroom context compression proxy - http://localhost:8787
After=network-online.target

[Container]
Image=ghcr.io/chopratejas/headroom:code-nonroot@sha256:a642ad983f35651272a5817f46b287132bad871cbbf0227bc65c8c825ab494e0
AutoUpdate=registry
ContainerName=headroom
UserNS=keep-id
Network=eternal.network
PublishPort=8787:8787
Volume=headroom.volume:/data
Volume=%h/.config/gcloud/application_default_credentials.json:/home/nonroot/.config/gcloud/application_default_credentials.json:ro,Z
Environment=HEADROOM_MODE=token
Environment=HEADROOM_CODE_AWARE_ENABLED=1
Environment=HEADROOM_LOG_LEVEL=INFO
Environment=HEADROOM_TELEMETRY=off
Environment=GOOGLE_APPLICATION_CREDENTIALS=/home/nonroot/.config/gcloud/application_default_credentials.json
Environment=VERTEX_TARGET_API_URL=https://aiplatform.googleapis.com
HealthCmd=curl -sf http://localhost:8787/health || exit 1
HealthInterval=30s
HealthRetries=3

[Service]
TimeoutStartSec=900
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
