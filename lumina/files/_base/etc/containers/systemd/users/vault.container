[Unit]
Description=A HashiCorp Vault development server
After=network-online.target

[Container]
Image=docker.io/hashicorp/vault:latest@sha256:e0acd3c681bdf57f002d7214e5d050b876e1704678005c6b0406dd96a65be919
AutoUpdate=registry
ContainerName=vault
Exec=server -dev
Environment=VAULT_DEV_ROOT_TOKEN_ID=root
Network=eternal.network
PublishPort=8200:8200

[Service]
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
