[Unit]
Description=A HashiCorp Vault development server
After=network-online.target

[Container]
Image=docker.io/hashicorp/vault:latest@sha256:962a92876e168d68eaaa24b0b8b49bbce1cb63024060a67bba95cd158a366fc2
AutoUpdate=registry
ContainerName=vault
Exec=server -dev
Environment=VAULT_DEV_ROOT_TOKEN_ID=root
Network=eternal.network
PublishPort=8200:8200

[Service]
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
