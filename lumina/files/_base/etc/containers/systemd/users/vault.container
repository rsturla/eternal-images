[Unit]
Description=A HashiCorp Vault development server
After=network-online.target

[Container]
Image=docker.io/hashicorp/vault:latest@sha256:5520cc26271c024e6ffa45cdf95255bd26b70d71ba4b7e0bc18925bef4128adb
AutoUpdate=registry
ContainerName=vault
Exec=server -dev
Environment=VAULT_DEV_ROOT_TOKEN_ID=root
Network=eternal.network
PublishPort=8200:8200

[Service]
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
