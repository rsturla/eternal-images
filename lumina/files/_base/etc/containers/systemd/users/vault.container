[Unit]
Description=A HashiCorp Vault development server
After=network-online.target

[Container]
Image=docker.io/hashicorp/vault:latest@sha256:c2f666266f383d2cf424d86b8bb8ce7d065562173ffec2b476d762943608bb55
AutoUpdate=registry
ContainerName=vault
Exec=server -dev
Environment=VAULT_DEV_ROOT_TOKEN_ID=root
Network=eternal.network
PublishPort=8200:8200

[Service]
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
