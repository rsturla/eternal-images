[Unit]
Description=A Qdrant container
After=network-online.target

[Container]
Image=docker.io/qdrant/qdrant:latest@sha256:d18c8e5061be3eaea2f53fbee1f0bf0382dc59cbb9b7112e41ffcc937ec14220
AutoUpdate=registry
ContainerName=qdrant
Network=eternal.network
PublishPort=6333:6333
PublishPort=6334:6334
Volume=qdrant.volume:/qdrant/storage:Z

[Service]
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
