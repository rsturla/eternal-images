[Unit]
Description=A Qdrant container
After=network-online.target

[Container]
Image=docker.io/qdrant/qdrant:latest@sha256:9bfc89f9914fc14876a88c05270685921a55b8877b254a98bcc1cc2f0a424cd2
AutoUpdate=registry
ContainerName=qdrant
Network=eternal.network
PublishPort=6333:6333
PublishPort=6334:6334
Volume=qdrant.volume:/qdrant/storage:Z

[Service]
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
