[Unit]
Description=A Neo4j container
After=network-online.target

[Container]
Image=docker.io/library/neo4j:latest@sha256:eedb3acecd599df040cc3eef195f7b2bc723876b12dbef87de470989a3104bf0
AutoUpdate=registry
ContainerName=neo4j
Environment=NEO4J_AUTH=none
PublishPort=7474:7474
PublishPort=7687:7687
Network=eternal.network
Volume=neo4j.volume:/data:Z

[Service]
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
