[Unit]
Description=A Valkey container
After=network-online.target

[Container]
Image=docker.io/valkey/valkey:latest@sha256:1c2b25b09f354c66fe994733acdf12fcfd4bdf6f3bd92b88a93a70378d884056
AutoUpdate=registry
ContainerName=valkey
Network=eternal.network
PublishPort=6379:6379
Volume=valkey.volume:/data:Z

[Service]
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
