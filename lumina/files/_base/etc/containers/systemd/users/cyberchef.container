[Unit]
Description=A CyberChef container - http://localhost:8080
After=network-online.target

[Container]
Image=ghcr.io/gchq/cyberchef:latest@sha256:379c6cbcfd8cc10b8e045548f3ebaa82ce429e4b40cf60e4532e116a4c67884d
AutoUpdate=registry
ContainerName=cyberchef
PublishPort=8080:80
Network=eternal.network

[Service]
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
